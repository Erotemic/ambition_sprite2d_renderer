; Generated/editor-facing Ambition pose authoring project.
; Authoritative character data lives in SVG rig metadata + motion JSON outside
; this project. Regenerate generated/ with godot_motion_tool.
config_version=5

[application]
config/name="Ambition Pose Authoring"
config/features=PackedStringArray("4.6", "GL Compatibility")

[editor_plugins]
enabled=PackedStringArray("res://addons/ambition_pose_editor/plugin.cfg")

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
