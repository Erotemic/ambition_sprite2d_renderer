        "root_y": {
          "expr": "-0.6*abs(sin(tau*t))"
        },
        "torso": {
          "expr": "-1 + 1.0*sin(tau*t)"
        },
        "head": {
          "expr": "-2 + 3*sin(tau*t)"
        },
        "near_arm_u": {
          "expr": "-6 + 4*sin(tau*t)"
        },
        "near_arm_l": {
          "expr": "-8 + 8*sin(tau*t+0.8)"
        },
        "near_hand": {
          "expr": "-((-6 + 4*sin(tau*t)) + (-8 + 8*sin(tau*t+0.8)))"
