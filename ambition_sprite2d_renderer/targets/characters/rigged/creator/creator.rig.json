      "frames": 6,
      "duration_ms": 100,
      "channels": {
        "root_x": {
          "expr": "2*(lambda u: u*u*(3-2*u))(max(0.0, min(1.0, (t-0.0)/0.35))) - 2*(lambda u: u*u*(3-2*u))(max(0.0, min(1.0, (t-0.75)/0.25)))"
        },
        "torso": {
          "expr": "4*(lambda u: u*u*(3-2*u))(max(0.0, min(1.0, (t-0.0)/0.35))) - 4*(lambda u: u*u*(3-2*u))(max(0.0, min(1.0, (t-0.75)/0.25)))"
        },
        "head": {
          "expr": "-6*(lambda u: u*u*(3-2*u))(max(0.0, min(1.0, (t-0.0)/0.35))) + 6*(lambda u: u*u*(3-2*u))(max(0.0, min(1.0, (t-0.75)/0.25)))"
        },
        "near_arm_u": {
          "expr": "-40*(lambda u: u*u*(3-2*u))(max(0.0, min(1.0, (t-0.0)/0.35))) + 40*(lambda u: u*u*(3-2*u))(max(0.0, min(1.0, (t-0.75)/0.25)))"
        },
        "near_arm_l": {
          "expr": "-14*(lambda u: u*u*(3-2*u))(max(0.0, min(1.0, (t-0.0)/0.35))) + 14*(lambda u: u*u*(3-2*u))(max(0.0, min(1.0, (t-0.75)/0.25)))"
        },
        "near_hand": {
          "expr": "-((-40*(lambda u: u*u*(3-2*u))(max(0.0, min(1.0, (t-0.0)/0.35))) + 40*(lambda u: u*u*(3-2*u))(max(0.0, min(1.0, (t-0.75)/0.25)))) + (-14*(lambda u: u*u*(3-2*u))(max(0.0, min(1.0, (t-0.0)/0.35))) + 14*(lambda u: u*u*(3-2*u))(max(0.0, min(1.0, (t-0.75)/0.25)))))"
        },
        "eye_open": {
          "expr": "0 if (False) else 1"
        },
        "eye_shut": {
          "expr": "1 if (False) else 0"
        },
        "mouth_open": {
          "expr": "1 if (0.3 < t < 0.75 and floor(t*6 + 0.01) % 2 == 0) else 0"
