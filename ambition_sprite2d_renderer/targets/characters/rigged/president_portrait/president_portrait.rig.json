        "mouth_open": {
          "expr": "1 if 0.1 < t < 0.6 else 0"
        },
        "eye_shut": {
          "expr": "1 if (t < 0.6) and not (t >= 0.6) else 0"
        },
        "eye_dead": {
          "expr": "1 if (t >= 0.6) else 0"
        },
        "eye_open": {
          "expr": "0 if (t < 0.6) or (t >= 0.6) else 1"
        }
      }
    }
  }
}
