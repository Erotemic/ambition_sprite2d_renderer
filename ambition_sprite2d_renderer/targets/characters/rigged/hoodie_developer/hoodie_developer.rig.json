          "expr": "-0.6*abs(sin(tau*t))"
        },
        "torso": {
          "expr": "-1 + 1.0*sin(tau*t)"
        },
        "head": {
          "expr": "-2 + 3*sin(tau*t)"
        },
        "near_arm_u": {
          "expr": "-6 + 4*sin(tau*t)"
        },
        "near_arm_l": {
          "expr": "-8 + 8*sin(tau*t+0.8)"
        },
        "near_hand": {
          "expr": "-((-6 + 4*sin(tau*t)) + (-8 + 8*sin(tau*t+0.8)))"
        },
        "eye_open": {
          "expr": "0 if (False) else 1"
        },
        "eye_shut": {
          "expr": "1 if (False) else 0"
        },
        "mouth_open": {
          "expr": "1 if (floor(t*6 + 0.01) % 2 == 0) else 0"
        }
      }
    }
  }
}
